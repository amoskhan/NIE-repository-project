# Normalize line endings on commit AND check everything out with LF, on every
# platform. The whole stack (dotnet publish, pnpm build, docker build, helm)
# runs in Linux containers, so a CRLF working tree only causes churn — and it
# breaks shell scripts outright ("/bin/bash^M: bad interpreter").
# Keep this in step with `end_of_line = lf` in .editorconfig.
* text=auto eol=lf

# Called out explicitly because breaking these is the loudest failure:
# LocalStack init hooks and task verify scripts run inside Linux containers.
*.sh text eol=lf

# Common binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles are generated: keep them out of diffs and merge conflicts noise.
pnpm-lock.yaml -diff linguist-generated
