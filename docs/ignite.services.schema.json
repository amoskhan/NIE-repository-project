{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignite.nie.edu.sg/schemas/ignite.services.schema.json",
  "title": "NIE Ignite workspace services",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "template": { "type": "string", "maxLength": 80 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "kind", "required"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "not": {
              "enum": ["postgres", "valkey", "runtime-gateway", "runtime-services-watcher"]
            }
          },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["frontend", "backend", "worker"] },
          "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 240 },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "project": { "type": "string", "minLength": 1, "maxLength": 240 },
          "assembly": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$" },
          "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
          "healthPath": { "type": "string", "pattern": "^/", "maxLength": 200 },
          "primary": { "type": "boolean" },
          "required": { "type": "boolean" },
          "environment": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "additionalProperties": { "type": "string", "maxLength": 1000 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "backend" } } },
            "then": {
              "oneOf": [
                {
                  "required": ["project", "assembly", "port"],
                  "not": { "anyOf": [{ "required": ["command"] }, { "required": ["workingDirectory"] }] }
                },
                {
                  "required": ["workingDirectory", "command", "port"],
                  "not": { "anyOf": [{ "required": ["project"] }, { "required": ["assembly"] }] }
                }
              ]
            }
          },
          {
            "if": { "properties": { "kind": { "const": "frontend" } } },
            "then": { "required": ["workingDirectory", "command", "port"] }
          },
          {
            "if": { "properties": { "kind": { "const": "worker" } } },
            "then": { "required": ["workingDirectory", "command"] }
          }
        ]
      }
    }
  }
}
