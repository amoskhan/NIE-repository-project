{
  "name": "@apptemplate/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./config": "./src/config/index.ts",
    "./composables": "./src/composables/index.ts",
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types/index.ts",
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "//build": "Same as @apptemplate/ui: this package is consumed FROM SOURCE (every exports entry points at ./src), so there is no bundle to produce. `build` is a type-check and nothing more — it exists so the workspace-level build script can validate the package.",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/instrumentation": "^0.215.0",
    "@opentelemetry/instrumentation-document-load": "^0.60.0",
    "@opentelemetry/instrumentation-fetch": "^0.215.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.215.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@sentry/vue": "^9.47.1",
    "axios": "^1.13.6",
    "js-cookie": "^3.0.5",
    "vue": "^3.5.30",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.10"
  }
}
