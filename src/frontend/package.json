{
  "name": "apptemplate-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AppTemplate frontend workspace - monorepo structure",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run -r --parallel dev",
    "dev:main": "pnpm --filter main dev",
    "dev:auth": "pnpm --filter auth dev",
    "build": "pnpm run build:ui && pnpm run build:shared && pnpm run build:main && pnpm run build:auth",
    "build:ui": "pnpm --filter @apptemplate/ui build",
    "build:shared": "pnpm --filter @apptemplate/shared build",
    "build:main": "pnpm --filter main build:production",
    "build:auth": "pnpm --filter auth build:production",
    "type-check": "pnpm run -r type-check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "generate:api": "node scripts/generate-api-types.mjs",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "//lint": "One flat config (eslint.config.js) covers all four workspace packages, so lint runs as a single process from here rather than recursing per package.",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.0"
  }
}
