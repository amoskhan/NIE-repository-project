{
  "ConnectionStrings": {
    "MainDbConnection": "Host=localhost;Port=5432;Database=AppTemplate;Username=postgres;Password=postgres"
  },
  "Valkey": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AppTemplate-auth-session-instance"
  },
  "ValidSessionTimeInMins": 90,
  "AuthService": {
    "BaseUrl": "https://localhost:5001"
  },
  "//Application": "Regional defaults shipped with the template. Change these for your own project: TimeZone accepts an IANA id ('Asia/Singapore', 'Europe/London') or a Windows id ('Singapore Standard Time'); Locale and Currency drive number/date/money formatting.",
  "Application": {
    "TimeZone": "Asia/Singapore",
    "Locale": "en-SG",
    "Currency": "SGD"
  },
  "AuditLog": {
    "RetentionMonths": 6,
    "BatchSize": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TickerQ": "Information"
    }
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "development",
    "ServiceName": "apptemplate-api",
    "TracesSampleRate": "0.2"
  },
  "OneSignal": {
    "AppId": "",
    "RestApiKey": ""
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Fixed": { "PermitLimit": 100, "WindowSeconds": 60, "QueueLimit": 10 },
    "Sliding": { "PermitLimit": 20, "WindowSeconds": 60, "QueueLimit": 5 }
  },
  "AllowedHosts": "*",
  "AllowedCORSOrigin": ["http://localhost:8001", "http://localhost:8002"],
  "FileStorage": {
    "Provider": "Local",
    "BasePath": "./uploads/AppTemplate",
    "S3": {
      "BucketName": "apptemplate-local",
      "KeyPrefix": "",
      "Region": "us-east-1",
      "ServiceUrl": "http://localhost:4566",
      "AccessKey": "test",
      "SecretKey": "test"
    }
  },
  "//EmailSettings": "Defaults point at the Mailpit dev mail catcher from docker compose (SMTP on localhost:1025, web UI on http://localhost:8025). SenderEmail is required — the app throws at startup of the email service if it is blank.",
  "EmailSettings": {
    "AppName": "App Template",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "SenderEmail": "no-reply@example.com",
    "SenderName": "App Template",
    "EnableSsl": false,
    "BccEmails": []
  }
}
