<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Additional settings specific to Services library -->
	</PropertyGroup>
	
	<ItemGroup>
		<!--
			Report header logo, embedded into the assembly and read back by
			PlaywrightPdfGenerationService via the LogicalName below.

			This asset is BACKEND-OWNED on purpose. It previously pointed at
			..\..\..\frontend\main\src\assets\app-logo.svg, which made the backend build
			depend on the frontend tree: a backend-only scaffold (copier `stack: backend`,
			which removes src/frontend/) could not compile, and build/Dockerfile.api needed
			an extra COPY just to stage the file at the right absolute path.
			Keep the path local — do not reintroduce a cross-tree reference.
		-->
		<EmbeddedResource Include="Services\PdfGeneration\Assets\report-logo.svg" LogicalName="Services.Services.Reports.ReportLogo.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AWSSDK.S3" Version="4.0.17" />
		<PackageReference Include="MailKit" Version="4.16.0" />
		<PackageReference Include="Mapster" Version="10.0.4" />
		<PackageReference Include="Mapster.EFCore" Version="10.0.4" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.6" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.17.0" />
		<PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AI\AI.csproj" />
		<ProjectReference Include="..\Data\Data.csproj" />
		<ProjectReference Include="..\Domain\Domain.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

</Project>
