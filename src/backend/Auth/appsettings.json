{
  "ConnectionStrings": {
    "MainDbConnection": "Host=localhost;Port=5432;Database=AppTemplate;Username=postgres;Password=postgres"
  },
  "Valkey": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "AppTemplate-auth-session-instance"
  },
  "AllowedHosts": "*",
  "AllowedCORSOrigin": ["http://localhost:8001", "http://localhost:8002"],
  "//LocalIdentity": "Policy for the built-in identity provider (UserAccounts table). Raise MinPasswordLength for anything real, and set AllowSelfRegistration to false for internal apps.",
  "LocalIdentity": {
    "MinPasswordLength": 12,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenTtlMinutes": 30,
    "AllowSelfRegistration": true
  },
  "//ExternalIdp": "Optional 'sign in with...' slot, shipped OFF and empty. Set Enabled plus a provider's Enabled/ClientId/ClientSecret/Authority to switch it on, and point RedirectUri at this API's /api/Auth/ExternalCallback. Keep ClientSecret out of source control (use user-secrets or ExternalIdp__Providers__Google__ClientSecret). Google authority: https://accounts.google.com. Microsoft: https://login.microsoftonline.com/{tenant}/v2.0. GitHub has no discovery document, so set its three endpoint overrides instead of Authority.",
  "ExternalIdp": {
    "Enabled": false,
    "Providers": {
      "Google": {
        "Enabled": false,
        "DisplayName": "Google",
        "ClientId": "",
        "ClientSecret": "",
        "Authority": "",
        "Scopes": "openid profile email",
        "RedirectUri": "",
        "AuthorizationEndpoint": "",
        "TokenEndpoint": "",
        "UserInfoEndpoint": ""
      },
      "Microsoft": {
        "Enabled": false,
        "DisplayName": "Microsoft",
        "ClientId": "",
        "ClientSecret": "",
        "Authority": "",
        "Scopes": "openid profile email",
        "RedirectUri": "",
        "AuthorizationEndpoint": "",
        "TokenEndpoint": "",
        "UserInfoEndpoint": ""
      },
      "GitHub": {
        "Enabled": false,
        "DisplayName": "GitHub",
        "ClientId": "",
        "ClientSecret": "",
        "Authority": "",
        "Scopes": "read:user user:email",
        "RedirectUri": "",
        "AuthorizationEndpoint": "",
        "TokenEndpoint": "",
        "UserInfoEndpoint": ""
      }
    }
  },
  "ValidSessionTimeInMins": 90,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Auth": "Debug"
    }
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "development",
    "ServiceName": "apptemplate-auth",
    "TracesSampleRate": "0.2"
  }
}
