# Files Prettier must never rewrite.
#
# Prettier is wired into the pre-commit hook through lint-staged (see
# package.json), so anything listed here is also safe from the hook.

# Dependencies and build output
node_modules/
dist/
.output/
coverage/

# .NET build output
bin/
obj/

# Generated lockfiles — regenerated by the package manager, never hand-edited.
pnpm-lock.yaml
package-lock.json

# EF Core migrations are generated by `dotnet ef migrations add`; reformatting
# them makes the diff against a regenerated migration meaningless.
src/backend/Libraries/Data/Migrations/

# Generated API types (see src/frontend/scripts/generate-api-types.mjs)
src/frontend/packages/shared/src/api-types/

# Template scaffolding: Copier renders these, the braces are not valid syntax
# for any Prettier parser.
*.jinja

# Helm chart templates are Go templates wearing a .yaml extension — the YAML
# parser cannot read `{{- range ... }}` and hard-errors on these four files.
deploy/helm/**/templates/
