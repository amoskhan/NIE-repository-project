# App Template E2E Tests - Development Environment
# This file is used for local development testing

# Base URL
BASE_URL=http://localhost

# API Endpoints (must end with /)
AUTH_API_URL=http://localhost:5001/api/
MAIN_API_URL=http://localhost:5002/api/

# Frontend URLs (must end with /)
# Ports come from the Vite configs: auth SPA = 8001, main SPA = 8002.
FRONTEND_AUTH=http://localhost:8001/
FRONTEND_MAIN=http://localhost:8002/

# Test User Credentials
# Leave blank in source control. Set personal/local credentials in tests/.env.dev.local.
TEST_USERNAME=
TEST_PASSWORD=

# Local identity provider - seeded development account
# Created by the backend when it seeds an empty database. Change these if you change
# the seed data. Never point these at a real account outside local development.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345

# Consecutive failed sign-ins the Auth API allows before locking an account.
AUTH_LOCKOUT_THRESHOLD=5

# Timeouts (milliseconds)
API_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000
EXPECT_TIMEOUT=10000

# Browser options
# Set to true for CI, false for local development with visible browser
HEADLESS=false

# Recording options (for debugging)
RECORD_VIDEO=false
SCREENSHOT_ON_FAILURE=true
