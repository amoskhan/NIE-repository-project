      { "id": "VEN-102", "name": "National Classroom Equipment and Accessible Learning Technologies Cooperative", "category": "Equipment", "contact": "orders@classroom.example", "status": "Active" },
      { "id": "VEN-103", "name": "Paper and Practice", "category": "Office supplies", "contact": "hello@practice.example", "status": "Under review" }
