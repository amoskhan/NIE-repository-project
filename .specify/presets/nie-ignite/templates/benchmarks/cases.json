      { "id": "REQ-205", "title": "Accessible classroom resource kits for the extended orientation programme", "owner": "Priya Nair", "supplier": "National Classroom Equipment Cooperative", "value": "$860.00", "items": "12 resource kits", "date": "21 Sep 2026" }
    ]
  }
}
