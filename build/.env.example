# App Template — environment for build/docker-compose.yml (single-host topology).
#
# Copy this file next to the compose file and fill it in:
#
#   cp build/.env.example build/.env
#
# Docker Compose reads `.env` from the directory of the compose file, so the
# copy MUST be called `build/.env`. It is git-ignored (this `.env.example` is
# not — see build/.gitignore); never commit real credentials.
#
# Then:
#   docker compose -f build/docker-compose.yml up -d
#
# Every variable here is REQUIRED. Compose substitutes an empty string for an
# unset variable and only warns, so a missing value shows up later as a
# confusing "invalid reference format" or an authentication failure rather than
# a clean error.

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

# Registry + namespace that hosts the three images built by CI. No trailing
# slash. Combined with the fixed image names this resolves to, for example,
#   ghcr.io/your-org/apptemplate-ui:<COMMIT_ID>
#   ghcr.io/your-org/apptemplate-auth-api:<COMMIT_ID>
#   ghcr.io/your-org/apptemplate-main-api:<COMMIT_ID>
# For a purely local build (`docker build -t local/apptemplate-ui:dev ...`) set
# this to the local prefix you tagged with, e.g. `local`.
DOCKER_REGISTRY_URL=ghcr.io/your-org

# Image tag to deploy. Use an immutable identifier — a git commit SHA or a
# release tag. Avoid `latest`: `docker compose up` will not re-pull it reliably
# and you lose the ability to say which build is running.
COMMIT_ID=v1.0.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Password for the `postgres` superuser in the apptemplate-postgres container.
#
# IMPORTANT: this must match the password in the connection strings inside
# build/appsettings.api.json and build/appsettings.auth.json — those files are
# mounted into the API containers and are NOT interpolated by Compose.
#
# It is only read on FIRST start, when the data directory (build/pgdata/) is
# initialised. Changing it later has no effect until you either run
# `ALTER ROLE postgres PASSWORD '...'` or delete build/pgdata/.
#
# Generate one, do not type one:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-before-you-deploy
